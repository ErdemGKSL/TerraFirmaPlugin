+    /**
+     * The {@code client_predictions} of carrier-policy.json, expanded: a {@code count} rule ({@code block}, property,
+     * {@code max}) yields {@code n -> n+1} for every n below max; a {@code source}/{@code result} rule yields itself.
+     */
+    static List<Prediction> predictions(String policyText, VanillaCandidates v) {
+        JsonObject root = Json.parse(policyText, VanillaCandidates.POLICY).getAsJsonObject();
+        if (!root.has("client_predictions")) {
+            return List.of();
+        }
+        List<Prediction> out = new ArrayList<>();
+        for (JsonElement x : root.getAsJsonObject("client_predictions").getAsJsonArray("rules")) {
+            JsonObject o = x.getAsJsonObject();
+            Set<String> allowed = new java.util.TreeSet<>();
+            o.getAsJsonArray("allowed_classes").forEach(c -> allowed.add(c.getAsString()));
+            String trigger = o.get("trigger").getAsString();
+            if (o.has("count")) {
+                String block = o.get("block").getAsString();
+                String prop = o.get("count").getAsString();
+                int max = o.get("max").getAsInt();
+                for (String state : v.allStates()) {
+                    if (!state.startsWith(block + "[")) {
+                        continue;
+                    }
+                    Map<String, String> p = props(state);
+                    int n = Integer.parseInt(p.get(prop));
+                    if (n < max) {
+                        p.put(prop, Integer.toString(n + 1));
+                        out.add(new Prediction(state, withProps(state, p), trigger, Set.copyOf(allowed)));
+                    }
+                }
+            } else {
+                out.add(new Prediction(o.get("source").getAsString(), o.get("result").getAsString(), trigger,
+                    Set.copyOf(allowed)));
+            }
+        }
+        return List.copyOf(out);
+    }
